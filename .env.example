# ------------------------------------------------------------------------------
# Example environment file.
#
# Copy this file to `.env` and adjust the values to match your environment.
#
# The `.env` file can be loaded directly by zekurix-server (for example when
# running `cargo run`, `cargo test`, or the application binary) and by Docker
# Compose when starting services.
# ------------------------------------------------------------------------------

# Path to a Zekurix configuration file.
#
# This variable is optional. When defined, zekurix-server loads additional
# settings from the specified TOML file.
#
# Startup fails if the file does not exist or cannot be read.
#
# Environment variables take precedence over values loaded from the TOML file.
#
# For local development, you can start from `config/zekurix.dev.toml`.
ZEKURIX_CONFIG_PATH=zekurix.toml

# ------------------------------------------------------------------------------
# PostgreSQL database connection
# ------------------------------------------------------------------------------

# Username used to authenticate against PostgreSQL.
ZEKURIX_DATABASE__USERNAME=postgres

# Password used to authenticate against PostgreSQL.
ZEKURIX_DATABASE__PASSWORD=change-me
