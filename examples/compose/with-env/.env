# ------------------------------------------------------------------------------
# Example environment file for Zekurix Server.
#
# This file is loaded automatically by Docker Compose when starting the stack.
#
# Only a subset of the available environment variables is shown here. Refer to
# the project documentation for the complete configuration reference.
#
# Review and adjust the values to match your environment before deploying
# to production.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------

# Minimum log level emitted by the application.
ZEKURIX_LOGGING__LEVEL=debug

# Output format used for application logs.
ZEKURIX_LOGGING__FORMAT=json

# ------------------------------------------------------------------------------
# PostgreSQL database connection
# ------------------------------------------------------------------------------

# Username used to authenticate against PostgreSQL.
ZEKURIX_DATABASE__USERNAME=postgres

# Password used to authenticate against PostgreSQL.
ZEKURIX_DATABASE__PASSWORD=change-me

# Enables automatic database migrations at startup.
ZEKURIX_DATABASE__MIGRATE=true

# ------------------------------------------------------------------------------
# JWT authentication
# ------------------------------------------------------------------------------

# Trusted JWT issuers used for token validation.
ZEKURIX_AUTHENTICATION__ISSUERS='["https://auth.example.com/my-issuer"]'

# JWT audience used for token validation.
ZEKURIX_AUTHENTICATION__AUDIENCE=zekurix

# JWKS file used for token signature validation.
ZEKURIX_AUTHENTICATION__PROVIDER__JWKS_FILE=/etc/zekurix/jwks.json

# ------------------------------------------------------------------------------
# Bootstrap super-admin
# ------------------------------------------------------------------------------

# JWT issuer of the identity provider that owns the initial super-admin account.
ZEKURIX_AUTHORIZATION__BOOTSTRAP__SUPER_ADMIN__ISSUER=https://auth.example.com/my-issuer

# JWT subject of the initial super-admin account in the identity provider.
ZEKURIX_AUTHORIZATION__BOOTSTRAP__SUPER_ADMIN__SUBJECT=admin
